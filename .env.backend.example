# EcoSusRural backend — environment variables
# Copy to .env.backend and fill in real values before starting in staging/prod.
# For local dev, the defaults in src/config.js are usually enough.

# ── Network ──────────────────────────────────────────────────────────────────
BACKEND_PORT=5000

# ── CORS ─────────────────────────────────────────────────────────────────────
# Set to your Flutter app's allowed origin(s) in production; leave unset for *.
CORS_ORIGIN=*

# ── AI service (external python service, if any) ────────────────────────────
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_COMPUTE_PATH=/compute
AI_SERVICE_TOKEN=
AI_API_KEY=

# ── Auth ─────────────────────────────────────────────────────────────────────
# Used as the symmetric key for mock/JWT signing in dev. Rotate in production.
JWT_MOCK_TOKEN_KEY=change-me-in-production
AUTH_TOKEN=

# ── Weather (Open-Meteo is free, no key required) ───────────────────────────
# Set WEATHER_API_KEY if your weather provider requires authentication.
# Leave empty for keyless Open-Meteo usage.
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
DEFAULT_LATITUDE=21.5999
DEFAULT_LONGITUDE=71.2162

# ── Redis (for cross-replica WebSocket fan-out + rate-limit buckets) ────────
REDIS_URL=redis://127.0.0.1:6379/0

# ── Node tuning ──────────────────────────────────────────────────────────────
NODE_ENV=production
UV_THREADPOOL_SIZE=8
