# Shared service contract for the environment-backed configuration normalization task.
# Flutter/Dart client
API_BASE_URL=http://127.0.0.1:5000/api
AI_SERVICE_URL=http://127.0.0.1:8000
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
# OpenWeatherMap key for the Weather Intelligence screen (bundled by default).
# When set, live refresh uses OpenWeatherMap; when empty it falls back to
# keyless Open-Meteo. Passed to the app with --dart-define=WEATHER_API_KEY=...
WEATHER_API_KEY=replace-with-openweathermap-key-or-leave-empty
# Google AI (Gemini) key for the EcoSusRural AI chat. Passed to the app with
# --dart-define=AI_API_KEY=... ; a bundled development key is used when unset.
AI_API_KEY=replace-with-google-ai-key-or-leave-empty
# Generative model used by EcoSusRural AI.
AI_MODEL_NAME=gemini-3.6-flash

# Express backend
BACKEND_PORT=5000
AI_SERVICE_COMPUTE_PATH=/compute
AI_SERVICE_TOKEN=replace-with-ai-service-token-or-empty
AUTH_TOKEN=jwt_mock_token_key
DEFAULT_LATITUDE=21.5999
DEFAULT_LONGITUDE=71.2162
CORS_ORIGIN=*

# Python AI service
AI_HOST=127.0.0.1
AI_PORT=8000
AI_SERVICE_SECRET=replace-with-service-secret
LOG_LEVEL=INFO
MODEL_NAME=sustainability-scorer
