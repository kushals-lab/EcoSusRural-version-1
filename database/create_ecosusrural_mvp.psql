-- Execute only in your private administrator psql session connected to the
-- postgres maintenance database. No passwords are stored in this file.
\set ON_ERROR_STOP on

DO $$
BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM pg_roles
    WHERE rolname = 'ecosusrural_app'
      AND rolcanlogin
      AND NOT rolsuper
      AND NOT rolcreatedb
      AND NOT rolcreaterole
      AND NOT rolreplication
      AND NOT rolbypassrls
  ) THEN
    RAISE EXCEPTION 'ecosusrural_app is absent or is not a least-privilege LOGIN role';
  END IF;
END;
$$;

SELECT CASE WHEN EXISTS (
  SELECT 1 FROM pg_database WHERE datname = 'ecosusrural_mvp'
) THEN 'false' ELSE 'true' END AS create_database \gset

\if :create_database
  CREATE DATABASE ecosusrural_mvp;
  REVOKE ALL ON DATABASE ecosusrural_mvp FROM PUBLIC;
  GRANT CONNECT ON DATABASE ecosusrural_mvp TO ecosusrural_app;
\else
  \echo 'ecosusrural_mvp already exists; no grants or ownership changed.'
\endif
