-- Read-only inventory by default. Run from a private administrator psql
-- session; no password is stored or printed by this file.
\set ON_ERROR_STOP on
\set database_name ecosusrural_mvp
\set app_role ecosusrural_app

SELECT datname AS database_name FROM pg_database
WHERE datname = :'database_name';
SELECT rolname AS role_name, rolcanlogin, rolsuper, rolcreatedb,
       rolcreaterole, rolreplication, rolbypassrls
FROM pg_roles WHERE rolname = :'app_role';
SELECT r.rolname AS role_name,
       has_database_privilege(r.rolname, :'database_name', 'CONNECT') AS can_connect
FROM pg_roles AS r
JOIN pg_database AS d ON d.datname = :'database_name'
WHERE r.rolname = :'app_role';

