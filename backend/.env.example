# Express backend runtime configuration
BACKEND_PORT=5000
PORT=5000
API_BASE_URL=http://127.0.0.1:5000/api
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_COMPUTE_PATH=/compute
AI_SERVICE_TOKEN=replace-with-ai-service-token-or-empty
AUTH_TOKEN=jwt_mock_token_key
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
DEFAULT_LATITUDE=21.5999
DEFAULT_LONGITUDE=71.2162
CORS_ORIGIN=*

# MongoDB Atlas. Put the real URI only in backend/.env.local (gitignored).
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ecosusrural?retryWrites=true&w=majority
MONGODB_DB_NAME=ecosusrural

# Server-side provider keys. Never pass these as Flutter dart-defines.
DATA_GOV_MANDI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
OPENWEATHER_API_KEYS=
GOOGLE_WEB_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com

# Redis for optional realtime scaling; email OTP uses MongoDB.
# Authentication security
REDIS_URL=redis://127.0.0.1:6379
OTP_HMAC_SECRET=replace_with_high_entropy_secret_32_bytes_minimum
JWT_SECRET=replace_with_jwt_secret_32_bytes_minimum

# Gmail example. Put real values only in backend/.env.local or host secrets.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sender@gmail.com
SMTP_PASS=
SMTP_FROM="EcoSusRural" <your-sender@gmail.com>

